        opp_board[row][col] = 'X';
    } else if (result == 'M') {
        opp_board[row][col] = ' ';
    }
    pthread_mutex_unlock(&board_mutex);
}

void update_my_board(int row, int col) {
    pthread_mutex_lock(&board_mutex);
    my_board[row][col] = 'X';
    pthread_mutex_unlock(&board_mutex);
}

int parse_coord(const char* coord, int* row, int* col) {
    if (strlen(coord) != 2) return 0;
    *row = coord[0] - '0';
    *col = coord[1] - 'A';
    if (*row < 0 || *row >= BOARD_SIZE) return 0;
    if (*col < 0 || *col >= BOARD_SIZE) return 0;
    return 1;
}

void* receive_thread(void* arg) {
    pkt packet;
    char coord[10];
    int r, c;
    int remaining;
    
    while (is_game_active) {
        if (mq_receive(in_q, (char*)&packet, sizeof(packet), NULL) == -1) {
            continue;
        }
        
        if (strcmp(packet.text, "YOUR_TURN") == 0) {
            is_my_turn = 1;
            printf("\n[GILIRAN ANDA]\n");
            draw();
            printf("Target: ");
            fflush(stdout);
        }
        else if (strcmp(packet.text, "WAIT") == 0) {
            is_my_turn = 0;
        }
        else if (strncmp(packet.text, "HIT", 3) == 0) {
            sscanf(packet.text, "HIT %d", &remaining);
            printf("\n[HASIL TEMBAKAN]\n");
            printf("Target %s: KENA KAPAL, SISA %d KAPAL LAGI\n", coord, remaining);
            printf("========================================\n");
            update_opp_board(r, c, 'X');
        }
        else if (strcmp(packet.text, "MISS") == 0) {
            printf("\n[HASIL TEMBAKAN]\n");
            printf("Target %s: MELESET\n", coord);
            printf("========================================\n");
            update_opp_board(r, c, 'M');
        }
        else if (strcmp(packet.text, "MISS_ALREADY") == 0) {
            printf("\n[HASIL TEMBAKAN]\n");
            printf("Target %s: SUDAH PERNAH DITEMBAK, MELESET\n", coord);
            printf("========================================\n");
        }
        else if (strcmp(packet.text, "WIN") == 0) {
            printf("\n[HASIL TEMBAKAN]\n");
            printf("SELAMAT! Anda MENANG!\n");
            printf("========================================\n");
            is_game_active = 0;
            break;
        }
        else if (strcmp(packet.text, "LOSE") == 0) {
            printf("\n[INFO] Anda KALAH!\n");
            is_game_active = 0;
            break;
        }
        else if (strncmp(packet.text, "OPPONENT_HIT", 12) == 0) {
            sscanf(packet.text, "OPPONENT_HIT %s %d", coord, &remaining);
            parse_coord(coord, &r, &c);
            update_my_board(r, c);
            printf("\n[INFO] Lawan menembak %s: KENA KAPAL, SISA %d KAPAL LAGI\n", 
                   coord, remaining);
        }
        else if (strncmp(packet.text, "OPPONENT_MISS", 13) == 0) {
            sscanf(packet.text, "OPPONENT_MISS %s", coord);
            printf("\n[INFO] Lawan menembak %s: MELESET\n", coord);
        }
        else if (strcmp(packet.text, "INVALID") == 0) {
            printf("\n[ERROR] Koordinat tidak valid! Gunakan format: 0A, 1B, 2C, 3D\n");
            is_my_turn = 1;
            printf("Target: ");
            fflush(stdout);
        }
    }
    
    return NULL;
}

int main() {
    struct mq_attr attr;
    attr.mq_flags = 0;
    attr.mq_maxmsg = 10;
    attr.mq_msgsize = sizeof(pkt);
    attr.mq_curmsgs = 0;
    
    in_q = mq_open(QUEUE_NAME1, O_RDWR);
    out_q = mq_open(QUEUE_NAME2, O_RDWR);
    
    if (in_q == -1 || out_q == -1) {
        printf("[ERROR] Gagal konek ke server!\n");
        return 1;
    }
    
    pthread_mutex_init(&board_mutex, NULL);
    init_boards();
    
    printf("[SENSOR] Terhubung ke server\n");
    printf("[SENSOR] Menunggu giliran...\n");
    
    pthread_t receiver;
    pthread_create(&receiver, NULL, receive_thread, NULL);
    
    char input[10];
    pkt packet;
    int r, c;
    
    while (is_game_active) {
        if (is_my_turn) {
            fgets(input, sizeof(input), stdin);
            input[strcspn(input, "\n")] = 0;
            
            if (strlen(input) == 0) continue;
            
            if (!parse_coord(input, &r, &c)) {
                printf("Format salah! Gunakan: 0A, 1B, 2C, 3D\n");
                printf("Target: ");
                fflush(stdout);
                continue;
            }
            
            strcpy(packet.text, input);
            mq_send(out_q, (char*)&packet, sizeof(packet), 0);
            is_my_turn = 0;
        }
        usleep(10000);
    }
    
    pthread_join(receiver, NULL);
    
    mq_close(in_q);
    mq_close(out_q);
    pthread_mutex_destroy(&board_mutex);
    
    return 0;
}
