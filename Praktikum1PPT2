#include <sys/stat.h>

FILE *log_file = NULL;

char honeypot_path[512];
char quarantine_path[512];
char logfile_path[512];
char pidfile_path[512];

void write_log(char *msg) {
    time_t now = time(NULL);
    struct tm *t = localtime(&now);
    fprintf(log_file, "[%04d-%02d-%02d %02d:%02d:%02d] %s\n",
        t->tm_year+1900, t->tm_mon+1, t->tm_mday,
        t->tm_hour, t->tm_min, t->tm_sec, msg);
    fflush(log_file);
}

void handle_sigterm(int sig) {
    write_log("Daemon berhenti");
    fclose(log_file);
    remove(pidfile_path);
    exit(0);
}

int is_suspicious(char *name) {
    char *ext = strrchr(name, '.');
    if (!ext) return 0;
    return (strcmp(ext, ".exe") == 0 || strcmp(ext, ".pcap") == 0);
}

int main() {
    char cwd[256];
    pid_t pid;
    FILE *pf;

    getcwd(cwd, sizeof(cwd));
    snprintf(honeypot_path,   sizeof(honeypot_path),   "%s/honeypot",     cwd);
    snprintf(quarantine_path, sizeof(quarantine_path), "%s/quarantine",   cwd);
    snprintf(logfile_path,    sizeof(logfile_path),    "%s/security.log", cwd);
    snprintf(pidfile_path,    sizeof(pidfile_path),    "%s/watcher.pid",  cwd);

    mkdir(honeypot_path, 0755);
    mkdir(quarantine_path, 0755);

    pid = fork();
    if (pid < 0) exit(1);
    if (pid > 0) exit(0);

    setsid();
    umask(0);

    pid = fork();
    if (pid < 0) exit(1);
    if (pid > 0) exit(0);

    chdir("/");
    close(STDIN_FILENO);
    close(STDOUT_FILENO);
    close(STDERR_FILENO);

    pf = fopen(pidfile_path, "w");
    if (pf) {
        fprintf(pf, "%d\n", getpid());
        fclose(pf);
    }

    log_file = fopen(logfile_path, "a");
    signal(SIGTERM, handle_sigterm);

    while (1) {
        DIR *d = opendir(honeypot_path);
        if (d) {
            struct dirent *e;
            while ((e = readdir(d)) != NULL) {
                char msg[512], src[512], dst[512];
                if (e->d_type != DT_REG) continue;
                if (!is_suspicious(e->d_name)) continue;
                snprintf(msg, sizeof(msg), "Peringatan! Menemukan file mencurigakan: %s", e->d_name);
                write_log(msg);
                snprintf(src, sizeof(src), "%s/%s", honeypot_path, e->d_name);
                snprintf(dst, sizeof(dst), "%s/%s", quarantine_path, e->d_name);
                rename(src, dst);
                snprintf(msg, sizeof(msg), "Berhasil mengkarantina file: %s", e->d_name);
                write_log(msg);
            }
            closedir(d);
        }
        sleep(1);
    }
    return 0;
}
