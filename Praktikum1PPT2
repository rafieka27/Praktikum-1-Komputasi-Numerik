#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <pthread.h>
#include <sys/ipc.h>
#include <sys/msg.h>
#include <unistd.h>

#define Q1 111
#define Q2 222

typedef struct {
    long type;
    int id;
    char loc;
    char stat;
    int exit;
} Msg;

typedef struct {
    long type;
    int id;
    char text[50];
    int shutdown;
} Res;

int qin, qout;
int running = 1;
int id;
pthread_mutex_t mtx;

void* listen_server(void* arg) {
    Res r;

    while (running) {
        msgrcv(qout, &r, sizeof(r)-sizeof(long), id, 0);

        pthread_mutex_lock(&mtx);

        if (r.shutdown) {
            printf("\n[INFO] Another sensor has exited\n");
	    printf("[INFO] Cancelling current input...\n");
	    printf("[INFO] System shutting down...\n");
            running = 0;
        } else if (strlen(r.text) > 0) {
            printf("\n[INFO] City: %s\n", r.text);
        }

        pthread_mutex_unlock(&mtx);
    }
    return NULL;
}

int valid(char loc, char stat) {
    if (id == 1 && !(loc=='A'||loc=='B')) return 0;
    if (id == 2 && !(loc=='C'||loc=='D')) return 0;
    if (!(stat=='H'||stat=='L')) return 0;
    return 1;
}

int main() {
    qin = msgget(Q1, 0666 | IPC_CREAT);
    qout = msgget(Q2, 0666 | IPC_CREAT);

    pthread_mutex_init(&mtx, NULL);

    Msg m;
    Res r;

    m.type = 1;
    m.id = getpid();
    msgsnd(qin, &m, sizeof(m)-sizeof(long), 0);

    msgrcv(qout, &r, sizeof(r)-sizeof(long), m.id, 0);
    id = r.id;

    printf("[SENSOR %d] Connected\n", id);

    pthread_t t;
    pthread_create(&t, NULL, listen_server, NULL);

    while (running) {
        printf("\nMasukkan data:\n");

        for (int i = 0; i < 2 && running; i++) {
            int input_id;
            char loc, stat;

            scanf("%d", &input_id);

            if (input_id == 0) continue;

            if (input_id != id) {
                printf("ID salah!\n");
                i--;
                continue;
            }

            scanf(" %c %c", &loc, &stat);

            if (!valid(loc, stat)) {
                printf("Invalid!\n");
                i--;
                continue;
            }

            m.type = 2;
            m.id = id;
            m.loc = loc;
            m.stat = stat;
            m.exit = 0;

            msgsnd(qin, &m, sizeof(m)-sizeof(long), 0);
        }

        char check[10];
        scanf("%s", check);

        if (strcmp(check, "exit") == 0) {
            m.type = 2;
            m.exit = 1;
            msgsnd(qin, &m, sizeof(m)-sizeof(long), 0);

            printf("[SENSOR] Sending exit signal...\n");
	    printf("[SENSOR] Shutting down...\n");
            running = 0;
        }
    }

    pthread_join(t, NULL);
    pthread_mutex_destroy(&mtx);
}
