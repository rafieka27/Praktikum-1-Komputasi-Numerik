#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <dirent.h>
#include <unistd.h>
#include <sys/wait.h>
#include <sys/stat.h>

void get_type(char *fname, char *out) {
    int i = 0;
    while (fname[i] && fname[i] != '_') {
        out[i] = fname[i];
        i++;
    }
    out[i] = '\0';
}

int main() {
    DIR *d = opendir("logs_dump");
    if (!d) {
        perror("gagal buka logs_dump");
        return 1;
    }

    char types[50][64];
    int type_count = 0;

    struct dirent *entry;
    while ((entry = readdir(d)) != NULL) {
        if (entry->d_type != DT_REG) continue;

        char type[64];
        get_type(entry->d_name, type);

        int found = 0;
        for (int i = 0; i < type_count; i++) {
            if (strcmp(types[i], type) == 0) {
                found = 1;
                break;
            }
        }
        if (!found) {
            strcpy(types[type_count++], type);
        }
    }
    closedir(d);

    for (int i = 0; i < type_count; i++) {
        pid_t pid = fork();

        if (pid < 0) {
            perror("fork gagal");
            return 1;
        }

        if (pid == 0) {
            char dest[128];
            snprintf(dest, sizeof(dest), "logs_dump/%s", types[i]);
            mkdir(dest, 0755);

            DIR *d2 = opendir("logs_dump");
            struct dirent *e;
            while ((e = readdir(d2)) != NULL) {
                if (e->d_type != DT_REG) continue;

                char t[64];
                get_type(e->d_name, t);
                if (strcmp(t, types[i]) != 0) continue;

                char src[256], dst[256];
                snprintf(src, sizeof(src), "logs_dump/%s", e->d_name);
                snprintf(dst, sizeof(dst), "logs_dump/%s/%s", types[i], e->d_name);

                rename(src, dst);
            }
            closedir(d2);

            printf("[%s] selesai dipindahkan\n", types[i]);
            exit(0);
        }
    }

    for (int i = 0; i < type_count; i++) {
        wait(NULL);
    }

    printf("klasifikasi selesai\n");
    return 0;
}
```

