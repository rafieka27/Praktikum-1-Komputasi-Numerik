#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <dirent.h>
#include <unistd.h>
#include <sys/wait.h>
#include <sys/stat.h>

#define LOGSDIR "logs_dump"
#define REPORT  "threat_report.txt"
#define BACKUP  "backup_evidence.zip"
#define TOPIP   5

typedef struct {
    char name[64];
    int count;
} Entry;

void swap(Entry *a, Entry *b) {
    Entry tmp = *a;
    *a = *b;
    *b = tmp;
}

void sort_desc(Entry *arr, int n) {
    int i, j;
    for (i = 0; i < n-1; i++)
        for (j = i+1; j < n; j++)
            if (arr[j].count > arr[i].count)
                swap(&arr[i], &arr[j]);
}

int find_or_add(Entry *arr, int *n, char *key) {
    int i;
    for (i = 0; i < *n; i++)
        if (strcmp(arr[i].name, key) == 0) return i;
    strcpy(arr[*n].name, key);
    arr[*n].count = 0;
    return (*n)++;
}

void get_ip(char *fname, char *out) {
    char *p = strchr(fname, '_');
    int i;
    if (!p) { out[0] = '\0'; return; }
    p++;
    for (i = 0; p[i] && p[i] != '_'; i++)
        out[i] = p[i];
    out[i] = '\0';
}

int main() {
    Entry types[64];
    Entry ips[2048];
    int nt = 0, ni = 0;
    int lim, i;
    DIR *dlog;
    struct dirent *cat;
    FILE *fp;
    pid_t pid;

    dlog = opendir(LOGSDIR);
    if (!dlog) { perror("gagal buka logs_dump"); return 1; }

    while ((cat = readdir(dlog)) != NULL) {
        char catpath[256];  
        DIR *dcat;
        struct dirent *f;

        if (cat->d_type != DT_DIR) continue;
        if (cat->d_name[0] == '.') continue;

        snprintf(catpath, sizeof(catpath), "%s/%s", LOGSDIR, cat->d_name);
        dcat = opendir(catpath);
        if (!dcat) continue;

        while ((f = readdir(dcat)) != NULL) {
            char ip[64];
            int ti, ii;

            if (f->d_type != DT_REG) continue;

            ti = find_or_add(types, &nt, cat->d_name);
            types[ti].count++;

            get_ip(f->d_name, ip);
            if (ip[0]) {
                ii = find_or_add(ips, &ni, ip);
                ips[ii].count++;
            }
        }
        closedir(dcat);
    }
    closedir(dlog);

    sort_desc(types, nt);
    sort_desc(ips, ni);

    fp = fopen(REPORT, "w");
    if (!fp) { perror("gagal buat report"); return 1; }

    fprintf(fp, "Laporan Klasifikasi Serangan:\n");
    for (i = 0; i < nt; i++)
        fprintf(fp, "%d. %s muncul sebanyak %d kali.\n", i+1, types[i].name, types[i].count);

    fprintf(fp, "\nTop 5 IP Mencurigakan:\n");
    lim = (ni < TOPIP) ? ni : TOPIP;
    for (i = 0; i < lim; i++)
        fprintf(fp, "%d. %s muncul sebanyak %d kali.\n", i+1, ips[i].name, ips[i].count);

    fclose(fp);
    printf("laporan berhasil dibuat\n");

    pid = fork();
    if (pid < 0) { perror("fork gagal"); return 1; }

    if (pid == 0) {
        char *args[] = {"zip", "-r", BACKUP, LOGSDIR, REPORT, NULL};
        execvp("zip", args);
        perror("execvp gagal");
        exit(1);
    }

    wait(NULL);
    printf("[Info] Laporan dan arsip berhasil dibuat\n");
    return 0;
}
```

